PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shortreel
# Where uploaded videos are stored. Leave empty for backend/uploads.
UPLOAD_DIR=
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Series Jeen API V2 catalog (optional). Keep the key here, never in the app.
SERIESJEEN_API_KEY=
SERIESJEEN_BASE_URL=https://api-v2.seriesjeen.online

# Local trial only: lets episode links work without a login token.
CATALOG_ALLOW_GUEST=false
