{
  "is_free": true
}

### 90. Like: viewer likes the film
# Expect: HTTP 200
#   check: liked
POST {{base_url}}/films/{{film_id}}/like HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 91. Like: guest cannot like
# Expect: HTTP 401
POST {{base_url}}/films/{{film_id}}/like HTTP/1.1

### 92. Like: viewer removes the like
# Expect: HTTP 200
DELETE {{base_url}}/films/{{film_id}}/like HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 93. Watchlist: save the film
# Expect: HTTP 200
POST {{base_url}}/films/{{film_id}}/watchlist HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 94. Watchlist: the saved list holds it
# Expect: HTTP 200
#   check: contains the film
GET {{base_url}}/watchlist HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 95. Watchlist: remove it
# Expect: HTTP 200
DELETE {{base_url}}/films/{{film_id}}/watchlist HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 96. Comments: guest can read
# Expect: HTTP 200
GET {{base_url}}/films/{{film_id}}/comments HTTP/1.1

### 97. Comments: guest cannot write
# Expect: HTTP 401
POST {{base_url}}/films/{{film_id}}/comments HTTP/1.1
Content-Type: application/json

{
  "body": "hi"
}

### 98. Comments: empty comment is refused
# Expect: HTTP 400
POST {{base_url}}/films/{{film_id}}/comments HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "body": ""
}

### 99. Comments: viewer writes one
# Expect: HTTP 201
# @name new_comment
POST {{base_url}}/films/{{film_id}}/comments HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "body": "Nice film"
}

### 100. Comments: someone else cannot delete it
# Expect: HTTP 403
DELETE {{base_url}}/comments/{{comment_id}} HTTP/1.1
Authorization: Bearer {{token_other_creator}}

### 101. Comments: the author deletes it
# Expect: HTTP 204
DELETE {{base_url}}/comments/{{comment_id}} HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 102. Follow: viewer follows the creator
# Expect: HTTP 200
POST {{base_url}}/creators/{{creator_id}}/follow HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 103. Follow: unfollow
# Expect: HTTP 200
DELETE {{base_url}}/creators/{{creator_id}}/follow HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 104. Report: viewer reports the film
# Expect: HTTP 201
# @name new_report
POST {{base_url}}/films/{{film_id}}/reports HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "reason": "Collection test report"
}

### 105. Admin: the report is listed
# Expect: HTTP 200
#   check: listed
GET {{base_url}}/admin/reports HTTP/1.1
Authorization: Bearer {{token_admin}}

### 106. Admin: resolve the report
# Expect: HTTP 200
POST {{base_url}}/admin/reports/{{report_id}}/resolve HTTP/1.1
Authorization: Bearer {{token_admin}}

### 107. Admin: viewer cannot resolve reports
# Expect: HTTP 403
POST {{base_url}}/admin/reports/{{report_id}}/resolve HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 108. Admin: user list
# Expect: HTTP 200
#   check: users
GET {{base_url}}/admin/users HTTP/1.1
Authorization: Bearer {{token_admin}}

### 109. Admin: live films
# Expect: HTTP 200
GET {{base_url}}/admin/films?status=approved HTTP/1.1
Authorization: Bearer {{token_admin}}

### 110. Admin: an unknown status filter is refused
# Expect: HTTP 400
GET {{base_url}}/admin/films?status=nope HTTP/1.1
Authorization: Bearer {{token_admin}}

### 111. Film: owner edits prices and details in one request (goes back to review)
# Expect: HTTP 200
PUT {{base_url}}/films/{{film_id}} HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: application/json

{
  "title": "Sprint film {{run_id}}",
  "genre": "Drama",
  "ai_tool": "Mixed",
  "prompt_credit": "prompt credit",
  "episode_prices": [
    {
      "id": "{{new_free_episode_id}}",
      "price_coins": 0
    }
  ]
}

### 112. Film: an owner edit puts it back in the review queue
# Expect: HTTP 200
#   check: queued again
GET {{base_url}}/admin/reviews HTTP/1.1
Authorization: Bearer {{token_admin}}

### 113. Film: admin approves it again
# Expect: HTTP 200
POST {{base_url}}/admin/films/{{film_id}}/review HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "status": "approved"
}

###############################################################
# 8 TAKE DOWN
###############################################################

### 114. Admin takes the film down
# Expect: HTTP 200
POST {{base_url}}/admin/films/{{film_id}}/review HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "status": "taken_down",
  "note": "Sprint 1-2 collection clean-up"
}

### 115. Guest can no longer see it
# Expect: HTTP 404
GET {{base_url}}/films/{{film_id}} HTTP/1.1

### 116. Even an unlocked viewer can no longer stream it
# Expect: HTTP 404
GET {{base_url}}/episodes/{{new_paid_episode_id}}/stream HTTP/1.1
Authorization: Bearer {{token_viewer}}
