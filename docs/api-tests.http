### 39. Review visibility: guest cannot see a pending film
# Expect: HTTP 404
GET {{base_url}}/films/{{film_id}} HTTP/1.1

### 40. Review visibility: pending film is not in the feed
# Expect: HTTP 200
#   check: not listed
GET {{base_url}}/films?q=Sprint%20film%20{{run_id}} HTTP/1.1

### 41. Review visibility: guest cannot stream a pending film
# Expect: HTTP 404
GET {{base_url}}/episodes/{{new_free_episode_id}}/stream HTTP/1.1

### 42. Review visibility: owner can see it
# Expect: HTTP 200
#   check: two episodes
GET {{base_url}}/films/{{film_id}} HTTP/1.1
Authorization: Bearer {{token_creator}}

### 43. Review: viewer cannot approve
# Expect: HTTP 403
POST {{base_url}}/admin/films/{{film_id}}/review HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "status": "approved"
}

### 44. Review: admin sees the film in the queue
# Expect: HTTP 200
#   check: queued
GET {{base_url}}/admin/reviews HTTP/1.1
Authorization: Bearer {{token_admin}}

### 45. Review: rejecting needs a note
# Expect: HTTP 400
POST {{base_url}}/admin/films/{{film_id}}/review HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "status": "rejected"
}

### 46. Review: a pending film cannot be taken down
# Expect: HTTP 409
POST {{base_url}}/admin/films/{{film_id}}/review HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "status": "taken_down",
  "note": "x"
}

### 47. Review: admin approves
# Expect: HTTP 200
#   check: approved
POST {{base_url}}/admin/films/{{film_id}}/review HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "status": "approved"
}

### 48. Review visibility: guest now sees the film
# Expect: HTTP 200
GET {{base_url}}/films/{{film_id}} HTTP/1.1

### 49. Ownership: other creator cannot edit the film
# Expect: HTTP 403
PUT {{base_url}}/films/{{film_id}} HTTP/1.1
Authorization: Bearer {{token_other_creator}}
Content-Type: application/json

{
  "title": "Hijack",
  "genre": "Drama",
  "ai_tool": "Mixed"
}

### 50. Ownership: other creator cannot delete the film
# Expect: HTTP 403
DELETE {{base_url}}/films/{{film_id}} HTTP/1.1
Authorization: Bearer {{token_other_creator}}

###############################################################
# 4 WALLET AND UNLOCK
###############################################################

### 51. Guest sees the new free episode, paid one is locked for a viewer
# Expect: HTTP 200
#   check: locked, no link
GET {{base_url}}/episodes/{{new_paid_episode_id}} HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 52. Unlock with no coins is refused (402)
# Expect: HTTP 402
#   check: code
POST {{base_url}}/episodes/{{new_paid_episode_id}}/unlock HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 53. Wallet: balance is still 0 after the refusal
# Expect: HTTP 200
#   check: 0 coins
GET {{base_url}}/wallet HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 54. Top-up: the client cannot choose the amount
# Expect: HTTP 400
POST {{base_url}}/wallet/topup HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "coins": 99999
}

### 55. Top-up: demo +100 (simulated)
# Expect: HTTP 201
#   check: 100 coins, simulated
POST {{base_url}}/wallet/topup HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "demo": true
}

### 56. Unlock: first time charges the server price
# Expect: HTTP 200
#   check: charged 30, balance 70
POST {{base_url}}/episodes/{{new_paid_episode_id}}/unlock HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 57. Unlock: repeating does not charge again
# Expect: HTTP 200
#   check: charged 0, balance still 70
POST {{base_url}}/episodes/{{new_paid_episode_id}}/unlock HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 58. Wallet: balance read from the server
# Expect: HTTP 200
#   check: 70 coins
GET {{base_url}}/wallet HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 59. Wallet: ledger lists the top-up and one unlock
# Expect: HTTP 200
#   check: two rows, newest first, with a paging flag
GET {{base_url}}/wallet/transactions?limit=50 HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 60. Wallet: unlocked list reads the rights themselves
# Expect: HTTP 200
#   check: one purchase
GET {{base_url}}/wallet/unlocked HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 61. Unlocked episode now has a playback link
# Expect: HTTP 200
#   check: unlocked with link
GET {{base_url}}/episodes/{{new_paid_episode_id}} HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 62. Another viewer is still locked out
# Expect: HTTP 403
GET {{base_url}}/episodes/{{new_paid_episode_id}}/stream HTTP/1.1
Authorization: Bearer {{token_other_creator}}

### 63. A film with paid unlocks cannot be deleted
# Expect: HTTP 409
DELETE {{base_url}}/films/{{film_id}} HTTP/1.1
Authorization: Bearer {{token_creator}}

### 64. A paid-for episode cannot be deleted
# Expect: HTTP 409
DELETE {{base_url}}/episodes/{{new_paid_episode_id}} HTTP/1.1
Authorization: Bearer {{token_creator}}

###############################################################
# 5 SUBSCRIPTION
###############################################################

### 65. Subscription: none yet
# Expect: HTTP 200
#   check: inactive
GET {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 66. Subscription: subscribe (simulated)
# Expect: HTTP 201
#   check: active with inclusive dates
# @name sub1
POST {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 67. Subscription: renew twice, plans never overlap
# Expect: HTTP 201
# @name sub2
POST {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 68. Subscription: third purchase starts after the second ends
# Expect: HTTP 201
#   check: paid through moved further and 3 plans remain
#   compare: paid_through is later than the paid_through of the previous request
POST {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 69. Subscription: the latest plan is read back
# Expect: HTTP 200
#   check: active, paid through is after the first end date
#   compare: paid_through is later than end_date of the first subscription
GET {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 70. Subscription: cancel keeps access until the end
# Expect: HTTP 200
#   check: still active, flagged cancelled
DELETE {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 71. Subscription: another user has nothing to cancel
# Expect: HTTP 404
DELETE {{base_url}}/subscription HTTP/1.1
Authorization: Bearer {{token_other_creator}}

###############################################################
# 6 REVENUE AND SHARE SETTING
###############################################################

### 72. Creator earnings match the stored 70/30 split
# Expect: HTTP 200
#   check: 30 coins spent, creator earned 21, in coins
GET {{base_url}}/creator/earnings HTTP/1.1
Authorization: Bearer {{token_creator}}

### 73. Admin sales: coins and simulated dollars stay separate
# Expect: HTTP 200
#   check: coin totals add up
GET {{base_url}}/admin/sales HTTP/1.1
Authorization: Bearer {{token_admin}}

### 74. Share setting: read
# Expect: HTTP 200
#   check: a percentage
GET {{base_url}}/admin/settings/revenue-share HTTP/1.1
Authorization: Bearer {{token_admin}}

### 75. Share setting: out of range is refused
# Expect: HTTP 400
PUT {{base_url}}/admin/settings/revenue-share HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "admin_share_percent": 101
}

### 76. Share setting: admin changes it to 50
# Expect: HTTP 200
PUT {{base_url}}/admin/settings/revenue-share HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "admin_share_percent": 50
}

### 77. Share setting: earnings recorded earlier do not change
# Expect: HTTP 200
#   check: still 21
GET {{base_url}}/creator/earnings HTTP/1.1
Authorization: Bearer {{token_creator}}

### 78. Share setting: put it back to 30
# Expect: HTTP 200
PUT {{base_url}}/admin/settings/revenue-share HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "admin_share_percent": 30
}

### 79. Role change: admin promotes the creator
# Expect: HTTP 200
PUT {{base_url}}/admin/users/{{creator_id}}/role HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "role": "admin"
}

### 80. Role change: past earnings do not change
# Expect: HTTP 200
#   check: still 21 after becoming admin
GET {{base_url}}/creator/earnings HTTP/1.1
Authorization: Bearer {{token_creator}}

### 81. Role change: demote again
# Expect: HTTP 200
PUT {{base_url}}/admin/users/{{creator_id}}/role HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "role": "creator"
}

### 82. Admin cannot change their own role
# Expect: HTTP 409
PUT {{base_url}}/admin/users/{{admin_id}}/role HTTP/1.1
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "role": "viewer"
}

