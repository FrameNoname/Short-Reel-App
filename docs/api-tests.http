# ShortReel Sprint 1-2 API tests (VS Code "REST Client" extension: humao.rest-client)
#
# HOW TO USE
#  1. Use a THROW-AWAY database and server, never the real `shortreel` (see docs/postman/README.md).
#  2. Edit the variables below, then run the requests TOP TO BOTTOM (click "Send Request" above each one).
#  3. Compare each response with the "Expect" lines above it.
#  4. Change @run_id every time you start a new full run (usernames must be new).
#
# Seed ids below (film 1, episode 1 = free, episode 3 = paid) are valid for a fresh database from shortreel.sql.

@base_url = http://localhost:3100/api
@run_id = r1
@admin_username = admin
# Password of the seed admin account (see README). Not stored in git: type it here locally.
@admin_password = 
@token_expired = expired.invalid.token

@seed_film_id = 1
@free_episode_id = 1
@paid_episode_id = 3

# Filled from earlier responses (do not edit)
@token_viewer = {{reg_viewer.response.body.$.token}}
@viewer_id = {{reg_viewer.response.body.$.user.id}}
@token_creator = {{reg_creator.response.body.$.token}}
@creator_id = {{reg_creator.response.body.$.user.id}}
@token_other_creator = {{reg_other.response.body.$.token}}
@token_admin = {{login_admin.response.body.$.token}}
@admin_id = {{login_admin.response.body.$.user.id}}
@film_id = {{new_film.response.body.$.film.id}}
@new_free_episode_id = {{up_free.response.body.$.episode.id}}
@new_paid_episode_id = {{up_paid.response.body.$.episode.id}}
@comment_id = {{new_comment.response.body.$.id}}
@report_id = {{new_report.response.body.$.id}}

###############################################################
# 1 GUEST AND PUBLIC
###############################################################

### 1. Health check
# Expect: HTTP 200
#   check: API and database are up
GET {{base_url}}/health HTTP/1.1

### 2. Guest: feed lists approved films only
# Expect: HTTP 200
#   check: feed has films
#   check: every film is approved
GET {{base_url}}/films?page_size=100 HTTP/1.1

### 3. Guest: film detail shows episodes with access labels
# Expect: HTTP 200
#   check: a free and a paid episode exist
#   check: free episode is labelled free, paid one login_required
GET {{base_url}}/films/{{seed_film_id}} HTTP/1.1

### 4. Guest: free episode gives a playback link
# Expect: HTTP 200
#   check: stream_url is a short-lived link
GET {{base_url}}/episodes/{{free_episode_id}} HTTP/1.1

### 5. Guest: paid episode has no playback link
# Expect: HTTP 200
#   check: stream_url is null and access is login_required
GET {{base_url}}/episodes/{{paid_episode_id}} HTTP/1.1

### 6. Guest: paid episode stream is denied
# Expect: HTTP 401
#   check: error code
GET {{base_url}}/episodes/{{paid_episode_id}}/stream HTTP/1.1

### 7. Guest: unlock needs a login
# Expect: HTTP 401
POST {{base_url}}/episodes/{{paid_episode_id}}/unlock HTTP/1.1

### 8. Public: lookups
# Expect: HTTP 200
#   check: genres and tools
GET {{base_url}}/lookups HTTP/1.1

### 9. Public: coin packs are labelled simulated
# Expect: HTTP 200
#   check: simulated
GET {{base_url}}/coin-packs HTTP/1.1

###############################################################
# 2 AUTH AND ROLES
###############################################################

### 10. Register viewer: valid
# Expect: HTTP 201
#   check: token and viewer role, no password in the answer
# @name reg_viewer
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "viewer_{{run_id}}",
  "password": "Sprint12pw",
  "role": "viewer"
}

### 11. Register viewer: duplicate username
# Expect: HTTP 409
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "viewer_{{run_id}}",
  "password": "Sprint12pw"
}

### 12. Register: password too short
# Expect: HTTP 400
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "short_{{run_id}}",
  "password": "a1"
}

### 13. Register: password without a number
# Expect: HTTP 400
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "nonum_{{run_id}}",
  "password": "onlyletters"
}

### 14. Register: missing username
# Expect: HTTP 400
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "password": "Sprint12pw"
}

### 15. Register: admin role is refused
# Expect: HTTP 403
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "sneaky_{{run_id}}",
  "password": "Sprint12pw",
  "role": "admin"
}

### 16. Register creator: valid
# Expect: HTTP 201
#   check: creator role
# @name reg_creator
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "creator_{{run_id}}",
  "password": "Sprint12pw",
  "role": "creator"
}

### 17. Register second creator (for ownership checks)
# Expect: HTTP 201
# @name reg_other
POST {{base_url}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "other_{{run_id}}",
  "password": "Sprint12pw",
  "role": "creator"
}

### 18. Login: valid
# Expect: HTTP 200
#   check: token returned
POST {{base_url}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "viewer_{{run_id}}",
  "password": "Sprint12pw"
}

### 19. Login: wrong password
# Expect: HTTP 401
POST {{base_url}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "viewer_{{run_id}}",
  "password": "wrong-password"
}

### 20. Login: unknown user gives the same message
# Expect: HTTP 401
#   check: same message as a wrong password
POST {{base_url}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "nobody_{{run_id}}",
  "password": "whatever1"
}

### 21. Login admin (seed account)
# Expect: HTTP 200
#   check: admin role
# @name login_admin
# (needs @admin_password set above)
POST {{base_url}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "{{admin_username}}",
  "password": "{{admin_password}}"
}

### 22. Token missing
# Expect: HTTP 401
GET {{base_url}}/auth/me HTTP/1.1

### 23. Token expired or invalid
# Expect: HTTP 401
GET {{base_url}}/auth/me HTTP/1.1
Authorization: Bearer {{token_expired}}

### 24. Me: valid token
# Expect: HTTP 200
#   check: own account
GET {{base_url}}/auth/me HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 25. Role: viewer cannot create a film
# Expect: HTTP 403
POST {{base_url}}/films HTTP/1.1
Authorization: Bearer {{token_viewer}}
Content-Type: application/json

{
  "title": "x",
  "genre": "Drama",
  "ai_tool": "Mixed",
  "prompt_credit": "p",
  "is_ai_generated": true
}

### 26. Role: viewer cannot open the admin queue
# Expect: HTTP 403
GET {{base_url}}/admin/reviews HTTP/1.1
Authorization: Bearer {{token_viewer}}

### 27. Role: creator cannot open the admin queue
# Expect: HTTP 403
GET {{base_url}}/admin/reviews HTTP/1.1
Authorization: Bearer {{token_creator}}

### 28. Role: creator cannot change the revenue share
# Expect: HTTP 403
PUT {{base_url}}/admin/settings/revenue-share HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: application/json

{
  "admin_share_percent": 10
}

### 29. Role: viewer has no creator earnings
# Expect: HTTP 403
GET {{base_url}}/creator/earnings HTTP/1.1
Authorization: Bearer {{token_viewer}}

###############################################################
# 3 UPLOAD AND REVIEW
###############################################################

### 30. Creator: film without the AI label is refused
# Expect: HTTP 400
POST {{base_url}}/films HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: application/json

{
  "title": "No label",
  "genre": "Drama",
  "ai_tool": "Mixed",
  "prompt_credit": "p",
  "is_ai_generated": false
}

### 31. Creator: film with an unknown genre is refused
# Expect: HTTP 400
POST {{base_url}}/films HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: application/json

{
  "title": "Bad genre",
  "genre": "Nope",
  "ai_tool": "Mixed",
  "prompt_credit": "p",
  "is_ai_generated": true
}

### 32. Creator: create film (pending)
# Expect: HTTP 201
#   check: starts pending
# @name new_film
POST {{base_url}}/films HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: application/json

{
  "title": "Sprint film {{run_id}}",
  "genre": "Drama",
  "ai_tool": "Mixed",
  "prompt_credit": "prompt credit",
  "is_ai_generated": true
}

### 33. Upload: other creator cannot add an episode to a pending film (hidden, 404)
# Expect: HTTP 404
POST {{base_url}}/films/{{film_id}}/episodes HTTP/1.1
Authorization: Bearer {{token_other_creator}}
Content-Type: multipart/form-data; boundary=----ShortReelBoundary

------ShortReelBoundary
Content-Disposition: form-data; name="video"; filename="demo_demo_clip_01.mp4"
Content-Type: video/mp4

< ../backend/uploads/demo_demo_clip_01.mp4
------ShortReelBoundary
Content-Disposition: form-data; name="price_coins"

0
------ShortReelBoundary--

### 34. Upload: not a video (wrong type)
# Expect: HTTP 400
POST {{base_url}}/films/{{film_id}}/episodes HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: multipart/form-data; boundary=----ShortReelBoundary

------ShortReelBoundary
Content-Disposition: form-data; name="video"; filename="not-a-video.txt"
Content-Type: text/plain

< ./postman/fixtures/not-a-video.txt
------ShortReelBoundary
Content-Disposition: form-data; name="price_coins"

0
------ShortReelBoundary--

### 35. Upload: MP4 header only, no video track
# Expect: HTTP 400
#   check: says why
POST {{base_url}}/films/{{film_id}}/episodes HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: multipart/form-data; boundary=----ShortReelBoundary

------ShortReelBoundary
Content-Disposition: form-data; name="video"; filename="header-only.mp4"
Content-Type: video/mp4

< ./postman/fixtures/header-only.mp4
------ShortReelBoundary
Content-Disposition: form-data; name="price_coins"

0
------ShortReelBoundary--

### 36. Upload: price above 500 is refused
# Expect: HTTP 400
POST {{base_url}}/films/{{film_id}}/episodes HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: multipart/form-data; boundary=----ShortReelBoundary

------ShortReelBoundary
Content-Disposition: form-data; name="video"; filename="demo_demo_clip_01.mp4"
Content-Type: video/mp4

< ../backend/uploads/demo_demo_clip_01.mp4
------ShortReelBoundary
Content-Disposition: form-data; name="price_coins"

501
------ShortReelBoundary--

