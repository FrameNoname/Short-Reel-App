# Expect: HTTP 400
PUT {{base_url}}/episodes/{{new_free_episode_id}} HTTP/1.1
Authorization: Bearer {{token_creator}}
Content-Type: application/json

{
  "price_coins": 501
}

### 89. Episode: owner puts it back to free
# Expect: HTTP 200
PUT {{base_url}}/episodes/{{new_free_episode_id}} HTTP/1.1
Authorization: Bearer {{token_creator}}
