{
  "info": {
    "name": "ShortReel manual tests",
    "description": "Manual API tests, no scripts. Send each request in order (folders 1 to 6) and compare the status with \"Expected\" in the request description.\n\nTokens: after Register viewer, Register creator and Login admin, copy the token from the response into the collection Variables tab (token_viewer, token_creator, token_admin) and save.\nfilm_id: copy the id from \"Create film\".\n\nUse a throwaway test server on port 3100 with a test database only (see docs/postman/README.md). Never point this at the real database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token_viewer",
      "value": ""
    },
    {
      "key": "token_creator",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "film_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 No login needed",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/health"
            },
            "description": "Expected: 200, status ok, db up",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Film feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/films"
            },
            "description": "Expected: 200, approved films only",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Film 1 details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/films/1"
            },
            "description": "Expected: 200, includes the episode list",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Free episode (episode 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/episodes/1"
            },
            "description": "Expected: 200, has a stream_url",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Paid episode (episode 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/episodes/3"
            },
            "description": "Expected: 200, stream_url is null",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Stream a paid episode without login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/episodes/3/stream"
            },
            "description": "Expected: 401 (correct: login required)",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Lookups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/lookups"
            },
            "description": "Expected: 200",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Coin packs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/coin-packs"
            },
            "description": "Expected: 200",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
