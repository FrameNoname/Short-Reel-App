              "raw": "http://localhost:3100/api/auth/register"
            },
            "description": "Expected: 201 with a token -> copy it into the token_viewer variable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"viewer_test\",\n  \"password\": \"Sprint12pw\",\n  \"role\": \"viewer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
