          "name": "Login wrong password",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/auth/login"
            },
            "description": "Expected: 401",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"viewer_test\",\n  \"password\": \"Wrong123pw\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
