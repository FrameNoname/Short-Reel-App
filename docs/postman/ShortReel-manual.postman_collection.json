        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/auth/login"
            },
            "description": "Expected: 200 with a token -> copy it into the token_admin variable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"1111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Profile without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/auth/me"
            },
            "description": "Expected: 401",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Profile with token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/auth/me"
            },
            "description": "Expected: 200, role viewer",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_viewer}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
