          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:3100/api/auth/login"
            },
            "description": "Expected: 200 with a token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"viewer_test\",\n  \"password\": \"Sprint12pw\"\n}",
